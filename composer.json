{
    "name": "ivancraft623/ranksystem",
    "description": "A rank and permissions manager for PocketMine-MP",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "axolotl-plugin-orphanage/commando": "^3.3.0",
        "axolotl-plugin-orphanage/config-updater": "^2.2.0",
        "bstats/pocketmine-mp": "^1.0.0",
        "ivancraft623/languages": "dev-main",
        "latampmdevs/formapi": "dev-master",
        "sof3/libasynql": "^4.2.3"
    },
    "require-dev": {
        "php": "^8.0",
        "phpstan/phpstan": "2.2.10",
        "pocketmine/pocketmine-mp": "^5.36.0",
        "sof3/pharynx": "^0.3.8"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/LatamPMDevs/FormAPI.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/IvanCraft623/languages.git"
        }
    ],
    "minimum-stability": "dev",
    "config": {
        "platform": {
            "php": "8.1"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-0": {
            "IvanCraft623\\RankSystem\\": "src"
        }
    }
}
